        {"type": "up", "x": 220, "y": 50}
      ]
    },
    {
      "name": "drag-start-marker", "size": [300, 100],
      "events": [
        {"type": "down", "x": 1, "y": 50}, {"type": "drag", "x": 45, "y": 50},
        {"type": "up", "x": 45, "y": 50}
      ]
    },
    {
      "name": "shift-click-loop-start", "size": [300, 100],
      "markers": {"loop": true, "loopStart": 0.2, "loopEnd": 1.8},
